    </fields>
    <fields>
        <fullName>Manager__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Manager of the requesting user for approval</description>
        <externalId>false</externalId>
        <label>Manager</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Managed_Comp_Requests</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Submission_Date__c</fullName>
        <description>Date and time when the request was submitted</description>
        <externalId>false</externalId>
        <label>Submission Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
</CustomObject>